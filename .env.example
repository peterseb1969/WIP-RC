# WIP connection
WIP_BASE_URL=https://localhost:8443
# Runtime key source: the live wip-deploy secrets file, read at startup, so a
# key rotation or redeploy needs no edit here. Used by the /wip proxy and the
# server's direct WIP calls (server/wip-key.ts). A literal WIP_API_KEY is the
# fallback when the file is unreadable or empty — that is how the deployer
# injects the key into the container, where this host-only path does not exist.
WIP_API_KEY_FILE=/Users/<you>/.wip-deploy/wip-local/secrets/api-key
# WIP_API_KEY=<plaintext key>

# MongoDB (direct connection for infra views)
MONGO_URI=mongodb://localhost:27017/
# MongoDB requires authentication on current WIP installs. In a container the
# deployer injects MONGO_USER / MONGO_PASSWORD (RC's manifest holds the
# read-only read-all role). Unset = anonymous. Never put credentials in
# MONGO_URI. On the host, point the file at the deployer's secret.
# MONGO_USER=react-console
# MONGO_PASSWORD_FILE=/Users/<you>/.wip-deploy/wip-local/secrets/mongo-password-react-console
# MONGO_PASSWORD=<plaintext password>

# NATS (direct connection for infra views)
NATS_URL=nats://localhost:4222
# NATS requires authentication on current WIP installs. Optional here: with
# nothing set the console connects anonymously. In a container the deployer
# injects NATS_URL / NATS_USER / NATS_PASSWORD (RC's manifest holds the
# read-only nats-monitor role).
# On the host, point the file at the deployer's secret (read on every
# connect, so a rotation needs no restart). Never put credentials in NATS_URL.
# NATS_USER=react-console
# NATS_PASSWORD_FILE=/Users/<you>/.wip-deploy/wip-local/secrets/nats-password-react-console
# NATS_PASSWORD=<plaintext password>
# NATS_CREDS_FILE=<path to a JWT + nkey .creds file; wins over user/password>
# NATS_INBOX_PREFIX=<reply inbox prefix; default _INBOX_<NATS_USER>>

# NL Query (Claude API). Optional — without it the NL Query page shows an
# "unavailable" notice; a key can also be set at runtime on the API Keys page.
# ANTHROPIC_API_KEY=sk-ant-...
# NL_QUERY_MODEL=claude-sonnet-5-5
# NL_QUERY_EFFORT=low   # low | medium | high | xhigh | max

# App (Express). Vite (5174) proxies to this port.
PORT=3011

# OIDC authentication (optional — enables user login via Dex). Unset = dev
# mode, or gateway auth via X-WIP-User headers behind wip-router.
# OIDC_ISSUER=http://localhost:5556/dex
# OIDC_INTERNAL_ISSUER=http://wip-dex:5556/dex
# OIDC_CLIENT_ID=wip-apps
# OIDC_CLIENT_SECRET=wip-apps-secret
# SESSION_SECRET=change-me-to-a-random-string

# App-level access control (optional)
# ALLOWED_GROUPS=wip-admins   # applied to the OIDC session and the gateway's X-WIP-Groups;
#                              # when set, requests without identity are refused
# WIP_ADMIN_GROUPS=wip-admins
