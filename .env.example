# WIP connection
WIP_BASE_URL=https://localhost:8443
# Runtime key source: the live wip-deploy secrets file, read at startup, so a
# key rotation or redeploy needs no edit here. Used by the /wip proxy and the
# server's direct WIP calls (server/wip-key.ts). A literal WIP_API_KEY is the
# fallback — and wins when set, which is how the deployer injects it into the
# container (where this host-only path does not exist).
WIP_API_KEY_FILE=/Users/<you>/.wip-deploy/wip-local/secrets/api-key
# WIP_API_KEY=<plaintext key>

# MongoDB (direct connection for infra views)
MONGO_URI=mongodb://localhost:27017/

# NATS (direct connection for infra views)
NATS_URL=nats://localhost:4222

# NL Query (Claude API). Optional — without it the NL Query page shows an
# "unavailable" notice; a key can also be set at runtime on the API Keys page.
# ANTHROPIC_API_KEY=sk-ant-...
# NL_QUERY_MODEL=claude-sonnet-4-6

# App (Express). Vite (5174) proxies to this port.
PORT=3011

# OIDC authentication (optional — enables user login via Dex). Unset = dev
# mode, or gateway auth via X-WIP-User headers behind wip-router.
# OIDC_ISSUER=http://localhost:5556/dex
# OIDC_INTERNAL_ISSUER=http://wip-dex:5556/dex
# OIDC_CLIENT_ID=wip-apps
# OIDC_CLIENT_SECRET=wip-apps-secret
# SESSION_SECRET=change-me-to-a-random-string

# App-level access control (optional)
# ALLOWED_GROUPS=wip-admins
# WIP_ADMIN_GROUPS=wip-admins
